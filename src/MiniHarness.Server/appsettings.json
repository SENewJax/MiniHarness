{
  "Urls": "http://127.0.0.1:5080",
  "Server": {
    "ModelAlias": "mini-agent",
    "ApiKey": "",
    "RequestTimeoutSeconds": 300,
    "MaxRequestBodyBytes": 1048576,
    "CancelOnDisconnect": false,
    "WorkspaceRoot": "",
    "WorkspaceGrants": []
  },
  "Model": {
    "Protocol": "Responses",
    "BaseUrl": "https://api.openai.com/v1/",
    "ApiKey": "",
    "Model": "",
    "TimeoutSeconds": 120,
    "MaxRetries": 2
  },
  "Harness": {
    "MaxModelCalls": 12,
    "MaxToolCalls": 24,
    "MaxTotalTokens": 50000,
    "MaxContextCharacters": 100000,
    "MaxOutputTokens": 2048,
    "ToolTimeoutSeconds": 10,
    "MaxToolOutputCharacters": 16000,
    "StopWhenUsageUnknown": true,
    "SystemInstructions": "Use tools when needed. Base your answer on actual observations."
  },
  "Tools": {
    "AllowedNames": ["echo", "add", "utc_time"]
  },
  "Coding": {
    "Enabled": false,
    "ArtifactDirectory": ".data/artifacts",
    "Grants": ["read", "write", "execute"],
    "RequiredVerification": [],
    "IgnoredDirectories": [],
    "Profiles": []
  },
  "Processes": {
    "Enabled": false,
    "Grants": ["read", "execute"],
    "PollMilliseconds": 500,
    "Limits": {
      "Directory": ".data/processes",
      "MaxSessions": 8,
      "MaxSessionsPerTask": 2,
      "MaxLifetimeSeconds": 3600,
      "StartTimeoutMilliseconds": 3000,
      "InputTimeoutMilliseconds": 2000,
      "CancelTimeoutMilliseconds": 5000,
      "MaxInputBytes": 4096,
      "MaxInputActions": 256,
      "MaxPageBytes": 8192,
      "MaxOutputMemoryBytes": 65536,
      "MaxOutputDiskBytes": 262144,
      "MaxWaitMilliseconds": 60000
    },
    "Profiles": []
  },
  "Context": {
    "Enabled": false,
    "TriggerRatio": 0.75,
    "TargetRatio": 0.55,
    "KeepRecentGroups": 2,
    "MaxSummaryCharacters": 6000,
    "SummaryMaxOutputTokens": 2048,
    "SummaryTimeoutSeconds": 60,
    "MaxSummaryCallsPerAdvance": 2,
    "MaxSummaryCallsPerTask": 32,
    "MinimumReductionRatio": 0.05,
    "FailureBackoffCalls": 2,
    "MaxCheckpointBytes": 67108864,
    "MaxHistoryReadBytes": 65536
  },
  "Recovery": {
    "Mode": "Manual",
    "MaxConcurrency": 2,
    "MaxAttempts": 1,
    "ManagementTimeoutSeconds": 10,
    "StartIntervalMilliseconds": 100,
    "AllowUsageReconciliation": false,
    "AllowResourceReconciliation": false
  },
  "Delivery": {
    "Enabled": false,
    "Directory": ".data/delivery",
    "AllowReview": false,
    "AllowAmendment": false,
    "AllowExternalEvidence": false,
    "AllowContinue": false,
    "AllowArtifactImport": false
  },
  "Storage": {
    "Directory": ".data/runs"
  },
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  }
}
