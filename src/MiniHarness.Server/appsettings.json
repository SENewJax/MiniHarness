{
  "Urls": "http://127.0.0.1:5080",
  "Server": {
    "ModelAlias": "mini-agent",
    "ApiKey": "",
    "RequestTimeoutSeconds": 300,
    "MaxRequestBodyBytes": 1048576,
    "CancelOnDisconnect": false,
    "WorkspaceRoot": "",
    "WorkspaceGrants": []
  },
  "Model": {
    "Protocol": "Responses",
    "BaseUrl": "https://api.openai.com/v1/",
    "ApiKey": "",
    "Model": "",
    "TimeoutSeconds": 120,
    "MaxRetries": 2
  },
  "Harness": {
    "MaxModelCalls": 12,
    "MaxToolCalls": 24,
    "MaxTotalTokens": 50000,
    "MaxContextCharacters": 100000,
    "MaxOutputTokens": 2048,
    "ToolTimeoutSeconds": 10,
    "MaxToolOutputCharacters": 16000,
    "StopWhenUsageUnknown": true,
    "SystemInstructions": "Use tools when needed. Base your answer on actual observations."
  },
  "Tools": {
    "AllowedNames": ["echo", "add", "utc_time"]
  },
  "Coding": {
    "Enabled": false,
    "ArtifactDirectory": ".data/artifacts",
    "Grants": ["read", "write", "execute"],
    "RequiredVerification": [],
    "IgnoredDirectories": [],
    "Profiles": []
  },
  "Storage": {
    "Directory": ".data/runs"
  },
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  }
}
